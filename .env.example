# 8080.ai OpenClaw plugin environment template.
# Copy this file to .env for local development. Do not commit real secrets.

# Optional: override the 8080.ai website URL used for browser login links.
AI8080_SITE_URL=https://8080.ai/

# Optional: override the 8080.ai API base URL.
AI8080_API_BASE_URL=https://api.8080.ai/api/v1
