{
  "id": "ai8080",
  "name": "8080.ai",
  "description": "Integrates the 8080.ai AI software development platform into OpenClaw.",
  "skills": [
    "./skills"
  ],
  "extensions": [
    "./dist/index.js"
  ],
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "ai8080_login",
      "ai8080_start_project",
      "ai8080_send_message",
      "ai8080_get_credits_balance",
      "ai8080_get_project_status",
      "ai8080_open_project_requirements",
      "ai8080_continue_project",
      "ai8080_trigger_agents",
      "ai8080_list_projects",
      "ai8080_select_project",
      "ai8080_select_button",
      "ai8080_task_list"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "siteUrl": {
        "type": "string",
        "default": "https://8080.ai/",
        "description": "8080.ai website URL."
      },
      "apiBaseUrl": {
        "type": "string",
        "default": "https://api.8080.ai/api/v1",
        "description": "8080.ai API base URL."
      },
      "pollingTimeoutMs": {
        "type": "number",
        "description": "Max milliseconds to poll project status before giving up. Default: 600000 (10 min)"
      }
    }
  }
}
