{
  "name": "8080",
  "version": "0.1.0",
  "type": "module",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0",
    "eventsource-parser": "^3.0.8",
    "open": "^10.1.0",
    "openclaw": ">=2026.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "esbuild": "^0.21.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:openclaw",
    "postinstall": "npm run build",
    "dev": "tsx watch index.ts",
    "start": "tsx index.ts"
  }
}
