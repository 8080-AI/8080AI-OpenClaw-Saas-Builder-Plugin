{
  "name": "8080ai",
  "version": "0.1.0",
  "description": "OpenClaw plugin for creating, managing, and building 8080.ai projects.",
  "type": "module",
  "license": "GPL-2.0-only",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "8080.ai",
    "ai", 
    "software-development"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "skills",
    "openclaw.plugin.json",
    "package.json",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "./skills"
    ],
    "contracts": {
      "tools": [
        "ai8080_login",
        "ai8080_start_project",
        "ai8080_send_message",
        "ai8080_get_credits_balance",
        "ai8080_get_project_status",
        "ai8080_open_project_requirements",
        "ai8080_continue_project",
        "ai8080_trigger_agents",
        "ai8080_list_projects",
        "ai8080_select_project",
        "ai8080_select_button",
        "ai8080_task_list"
      ]
    }
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0",
    "eventsource-parser": "^3.0.8",
    "openclaw": ">=2026.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "esbuild": "^0.21.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:openclaw",
    "prepack": "npm run build",
    "dev": "tsx watch index.ts",
    "start": "tsx index.ts"
  }
}
